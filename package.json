{
  "name": "nexa-ui",
  "version": "0.1.0",
  "description": "Modern Vue 3 component library with atomic design principles",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "typescript",
    "unocss"
  ],
  "main": "./dist/nexa-ui.umd.cjs",
  "module": "./dist/nexa-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/nexa-ui.js",
      "require": "./dist/nexa-ui.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,js,ts,jsx,tsx,json,css,scss,md}\""
  },
  "peerDependencies": {
    "vue": "~3.4.0"
  },
  "dependencies": {
    "@vueuse/motion": "^2.2.3"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.1.66",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/vue": "^8.0.3",
    "@types/node": "^20.11.30",
    "@unocss/preset-attributify": "^0.58.6",
    "@unocss/preset-icons": "^0.58.6",
    "@unocss/preset-uno": "^0.58.6",
    "@unocss/preset-web-fonts": "^0.58.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^1.4.0",
    "@vue/test-utils": "^2.4.5",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "happy-dom": "^14.3.9",
    "prettier": "^3.2.5",
    "typescript": "^5.4.3",
    "unocss": "^0.58.6",
    "vite": "^5.2.6",
    "vite-plugin-dts": "^5.0.2",
    "vitepress": "^1.0.2",
    "vitest": "^1.4.0",
    "vue": "^3.4.21",
    "vue-tsc": "^2.0.7"
  }
}
