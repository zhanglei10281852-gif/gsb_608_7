{
  "name": "nexa-ui",
  "version": "0.1.0",
  "description": "Modern Vue 3 component library with atomic design principles",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "typescript",
    "unocss"
  ],
  "main": "./dist/nexa-ui.umd.cjs",
  "module": "./dist/nexa-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/nexa-ui.js",
      "require": "./dist/nexa-ui.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:app": "vite build --config vite.config.app.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@vueuse/motion": "^2.2.0",
    "vue": "~3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@iconify-json/carbon": "^1.1.31",
    "@iconify-json/mdi": "^1.1.64",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^20.14.0",
    "@unocss/preset-icons": "^0.62.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vue/test-utils": "^2.4.3",
    "@vueuse/motion": "^2.2.0",
    "eslint": "^9.6.0",
    "eslint-plugin-vue": "^9.28.0",
    "happy-dom": "^14.0.0",
    "prettier": "^3.3.0",
    "typescript": "~5.3.0",
    "typescript-eslint": "^8.0.0",
    "unocss": "^0.62.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vitepress": "^1.3.0",
    "vitest": "^1.6.0",
    "vue": "~3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
