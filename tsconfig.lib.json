{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": [
    "src/**/*.test.ts",
    "src/main.ts",
    "src/App.vue",
    "src/counter.ts",
    "node_modules",
    "dist",
    "dist-app"
  ]
}
